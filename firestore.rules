rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== HELPER FUNCTIONS =====
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() 
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // ===== MOCK DELIVERIES =====
    // Allow server-side writes via Admin SDK (bypasses rules)
    // Client-side still requires auth
    match /mockDeliveries/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // ===== PUBLIC RATE LIMIT ACCESS =====
    // These MUST be public for login rate limiting to work
    match /failedLogins/{ip} {
      allow read, write: if true;
    }
    
    match /rateLimits/{email} {
      allow read, write: if true;
    }
    
    // ===== USER ACCESS RULES =====
    match /users/{userId} {
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow read, update: if isAuthenticated() && (
        request.auth.uid == userId || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }
    
    // ===== REPORT DATA COLLECTIONS =====
    // Use {document=**} to match ALL documents and subcollections
    match /shipments/{document=**} {
      allow read, write: if isAuthenticated();
    }
    
    match /inventory/{document=**} {
      allow read, write: if isAuthenticated();
    }
    
    // KEY FIX: Use {document=**} for reports to match subcollections
    match /reports/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /mockDeliveries/{document=**} {
      allow read, write: if isAuthenticated();
    }
    
    match /dashboardMetrics/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // ===== NEW: SCHEDULED EVENTS COLLECTION =====
    match /scheduledEvents/{document=**} {
      allow read, write: if isAuthenticated();
    }
    
    // ===== DEFAULT DENY ALL =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}